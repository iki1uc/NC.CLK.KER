<script>

const directions = [
  "NORTH",
  "SOUTH",
  "EAST",
  "WEST",
  "UP",
  "DOWN",
  "IN",
  "OUT",
  "NC"
];

function runSCSI(){

  const root = [

    {
      source:"ESSENZ",
      raw:"NORTH"
    },

    {
      source:"WURZEL729",
      raw:"WEST"
    },

    {
      source:"GRUNDREGEL",
      raw:"EAST"
    },

    {
      source:"REGELSATZ",
      raw:"EAST"
    }

  ];

  return{
    root,
    count:root.length
  };
}

function detectConflicts(sourceValues){

  const keys = Object.keys(sourceValues);

  if(keys.length < 2){
    return [];
  }

  const allValues = [];

  Object.entries(sourceValues)
  .forEach(([s,v]) => {

      allValues.push({
          source:s,
          value:v.join("|")
      });

  });

  const unique =
      [...new Set(allValues.map(x=>x.value))];

  if(unique.length <= 1){
      return [];
  }

  return [{
      id:"SOURCE_VARIATION",
      sources:allValues.map(x=>x.source),
      variants:allValues.map(x=>x.value)
  }];
}

function runRAID(scsi){

  const valueMap = {};
  const sourceValues = {};

  scsi.root.forEach(entry => {

    const source = entry.source;
    const value = String(entry.raw).trim();

    if(!sourceValues[source]){
      sourceValues[source] = [];
    }

    sourceValues[source].push(value);

    const key = value.toUpperCase();

    if(!valueMap[key]){
      valueMap[key] = [];
    }

    valueMap[key].push(source);

  });

  const results = [];

  Object.entries(valueMap).forEach(([value,sources])=>{

      const uniqueSources =
         [...new Set(sources)];

      results.push({

        value,

        confirmations:
          uniqueSources.length,

        sources: uniqueSources,

        status:
          uniqueSources.length >= 2
          ? "CONFIRMED"
          : "UNVERIFIED"

      });

  });

  const conflicts =
      detectConflicts(sourceValues);

  conflicts.forEach(c => {

      results.push({

        value:c.id,
        confirmations:0,
        sources:c.sources,
        status:"CONFLICT",
        variants:c.variants

      });

  });

  return{
      entries:results,
      conflicts
  };

}

function runSLI(raid){

  const out = [];

  for(let i=0;i<raid.entries.length;i++){

    for(let j=i+1;j<raid.entries.length;j++){

      out.push({

        left:raid.entries[i].value,
        right:raid.entries[j].value

      });

    }

  }

  return out;

}

function buildRoot(){

  const scsi = runSCSI();

  const raid = runRAID(scsi);

  const sli = runSLI(raid);

  return {
    scsi,
    raid,
    sli
  };

}

const rootEngine = buildRoot();

const raidConfirmed =
rootEngine.raid.entries.filter(
x=>x.status==="CONFIRMED"
);

const raidUnverified =
rootEngine.raid.entries.filter(
x=>x.status==="UNVERIFIED"
);

const raidConflicts =
rootEngine.raid.entries.filter(
x=>x.status==="CONFLICT"
);

document.getElementById("confirmedCount").textContent =
raidConfirmed.length;

document.getElementById("mergedCount").textContent =
rootEngine.scsi.count;

document.getElementById("compareCount").textContent =
rootEngine.sli.length;

document.getElementById("conflictCount").textContent =
raidConflicts.length;

const raidGrid =
document.getElementById("raidGrid");

rootEngine.raid.entries.forEach(entry=>{

   const div =
   document.createElement("div");

   div.className =
   "raid-entry " +
   entry.status.toLowerCase();

   div.innerHTML = `

      <div class="badge ${entry.status.toLowerCase()}">
         ${entry.status}
      </div>

      <pre>
VALUE : ${entry.value}

CONFIRMATIONS :
${entry.confirmations}

SOURCES :
${entry.sources.join(", ")}

${entry.variants
? "VARIANTS :\n" + entry.variants.join("\n")
: ""}
      </pre>

   `;

   raidGrid.appendChild(div);

});

console.log(rootEngine);

</script>

